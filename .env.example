# Supabase project settings (Settings > API in Supabase dashboard)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Password to access the admin panel (change this!)
ADMIN_PASSWORD=change-this-password

# Port for local dev (Render/Railway set this automatically in production)
PORT=3000
